<style>
    body {
      margin: 0;
      font-family: 'Poppins', sans-serif;
      background: #0a0a0f; /* dark tech background */
      color: #e0e0e0;
    }

    /* Navigation Bar */
    nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: linear-gradient(90deg, #001f3f, #0074D9); /* tech blue gradient */
      padding: 15px 40px;
      position: sticky;
      top: 0;
      z-index: 1000;
    }
    .logo {
      font-size: 1.5em;
      font-weight: bold;
      color: #FFD700; /* telecom gold */
    }
    .menu {
      display: flex;
      gap: 25px;
    }
    .menu a {
      color: #fff;
      text-decoration: none;
      font-weight: 500;
      transition: color 0.3s;
    }
    .menu a:hover {
      color: #00FF7F; /* neon green hover */
    }

    /* Hero Section */
    .hero {
      text-align: center;
      padding: 80px 20px;
      background: linear-gradient(to right, #0074D9, #FFD700);
      color: #fff;
    }
    .hero h1 {
      font-size: 3em;
      margin-bottom: 10px;
    }
    .hero p {
      font-size: 1.2em;
    }

    /* Section Styling */
    section {
      padding: 60px 20px;
      max-width: 1100px;
      margin: auto;
    }
    h2 {
      color: #FFD700;
      margin-bottom: 30px;
      text-align: center;
    }

    /* Card Grid */
    .card-container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px;
    }
    .card {
      background: #111;
      padding: 25px;
      border-radius: 10px;
      border: 1px solid #00FF7F;
      box-shadow: 0 0 10px rgba(0,255,127,0.4);
      transition: transform 0.3s;
    }
    .card:hover {
      transform: translateY(-5px);
      box-shadow: 0 0 20px rgba(0,255,127,0.7);
    }
    .card h3 {
      color: #FFD700;
      margin-bottom: 10px;
    }

    footer {
      background: #001f3f;
      text-align: center;
      padding: 20px;
      color: #ccc;
    }
  </style>
